# ─────────────────────────────────────────────────────────────────────────────
# VerityText — optional environment configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` (never commit real credentials).
#
# Detection is fully self-contained and needs NO configuration. The variables
# below only affect (a) the humanizer's LLM backend, (b) the optional
# Postgres history store, and (c) the public site URL used in social metadata.
# Landing-page photography is bundled in public/images, so PIXABAY_API_KEY and
# PEXELS_API_KEY are not read by the app.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public site URL (optional) ───────────────────────────────────────────────
# Used to resolve Open Graph / Twitter image URLs. In production set this to
# the deployed origin, e.g. https://veritytext.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Humanizer LLM (optional) ─────────────────────────────────────────────────
# Pick ONE provider. Providers are resolved as whole units, in this order:
# LLM_* → OPENROUTER_* → OPENAI_*.
#
# Option A — any OpenAI-compatible endpoint:
#   LLM_BASE_URL   e.g. https://api.openai.com/v1
#   LLM_API_KEY    your API key
#   LLM_MODEL      e.g. gpt-4o-mini
#
# Option B — OpenRouter (defaults to https://openrouter.ai/api/v1):
#   OPENROUTER_API_KEY   your OpenRouter key
#   OPENROUTER_MODEL     e.g. anthropic/claude-sonnet-4.5
#   OPENROUTER_BASE_URL  optional, defaults to https://openrouter.ai/api/v1
#   OPENROUTER_SITE_URL  optional attribution header (HTTP-Referer)
#   OPENROUTER_APP_NAME  optional attribution header (X-Title)
#
# Option C — OpenAI directly: OPENAI_API_KEY, OPENAI_MODEL, OPENAI_BASE_URL.
#
# Option D — z-ai-web-dev-sdk:
#   Create a `.z-ai-config` file in the project root (it is gitignored):
#     { "baseUrl": "https://…/v1", "apiKey": "…", "chatId": "optional", "userId": "optional" }
#
# If neither is configured, the app still works: the humanizer degrades
# gracefully and returns the original text with a visible error banner.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Optional database (opt-in history) ───────────────────────────────────────
# Only needed for the optional "Save to history" feature. The default session
# store is in-memory with a one-hour TTL and writes nothing to disk.
# Requires Postgres (Supabase works). After setting this, run:
#   npx prisma db push
# Postgres example (Supabase): postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=
