// VerityText optional history store.
//
// Sessions are in-memory by default. A document is written here only when the
// user explicitly enables "Save to history" before uploading. Rows are scoped
// to an anonymous, httpOnly owner cookie so one browser cannot read another's
// history. Deleting a row (or clearing cookies) removes access immediately.
//
// This feature requires a Postgres database (Supabase works). Set DATABASE_URL
// and run `npx prisma db push`. Without DATABASE_URL, the app runs normally and
// the history endpoints report that history is not configured.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HistorySession {
  id                  String   @id
  ownerId             String
  filename            String
  fileType            String
  fileSize            Int
  extractedLength     Int
  wordCount           Int
  originalText        String
  humanizedText       String?
  aiProbability       Int
  verdict             String
  band                String
  confidence          Int
  reportJson          String
  humanizedReportJson String?
  humanizeMetaJson    String?
  hasHumanized        Boolean  @default(false)
  humanizedScore      Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([ownerId, updatedAt])
}
